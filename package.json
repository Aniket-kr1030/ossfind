{
  "name": "ossfind",
  "version": "0.1.0",
  "description": "Safety-ranked open-source component discovery across npm, PyPI, GitHub, and Hugging Face for humans and AI agents.",
  "type": "module",
  "keywords": [
    "open-source",
    "component-discovery",
    "npm",
    "pypi",
    "github",
    "hugging-face",
    "ai-agents",
    "security"
  ],
  "files": [
    "dist",
    "public",
    "fixtures",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gates": "tsx src/gates/run.ts",
    "mcp": "tsx src/mcp/server.ts",
    "web": "npm run build && node dist/web/server.js",
    "web:dev": "tsx watch src/web/server.ts",
    "demo": "npm run build && node scripts/demo.mjs",
    "bench": "npm run build && node scripts/bench.mjs",
    "index:build": "tsx scripts/build-index.mjs"
  },
  "bin": {
    "ossfind-mcp": "dist/mcp/server.js",
    "ossfind-web": "bin/ossfind-web"
  },
  "devDependencies": {
    "@types/cvss": "^1.0.3",
    "@types/node": "^26.2.0",
    "@types/semver": "^7.8.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cvss": "^1.0.5",
    "semver": "^7.8.5",
    "typescript": "^5.9.0",
    "zod": "^3.25.0"
  },
  "license": "MIT",
  "author": "Aniket",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aniket-kr1030/ossfind.git"
  },
  "bugs": {
    "url": "https://github.com/Aniket-kr1030/ossfind/issues"
  },
  "homepage": "https://github.com/Aniket-kr1030/ossfind#readme"
}
